{
  "manifest_version": 3,
  "name": "Reasonix Browser Bridge",
  "version": "2.3.0",
  "description": "Reasonix 的自动化浏览器插件（最大权限版）：通过 MCP 让 Reasonix 控制你的浏览器——标签页、Cookie、任意 JS、截图、下载、代理、数据清理。Chrome / Edge 通用，开源。",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "alarms",
    "webNavigation",
    "debugger",
    "downloads",
    "proxy",
    "browsingData",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "history",
    "bookmarks",
    "management",
    "contextMenus",
    "unlimitedStorage",
    "sessions"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reasonix Browser Bridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
